{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "/sw.js",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate",
        "Content-Type": "application/javascript"
      },
      "continue": true
    },
    {
      "src": "/manifest.json",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate",
        "Content-Type": "application/manifest+json"
      },
      "continue": true
    },
    {
      "src": "/icon-192.svg",
      "headers": {
        "Content-Type": "image/svg+xml"
      },
      "continue": true
    },
    {
      "src": "/icon-512.svg",
      "headers": {
        "Content-Type": "image/svg+xml"
      },
      "continue": true
    },
    {
      "src": "/favicon.svg",
      "headers": {
        "Content-Type": "image/svg+xml"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
